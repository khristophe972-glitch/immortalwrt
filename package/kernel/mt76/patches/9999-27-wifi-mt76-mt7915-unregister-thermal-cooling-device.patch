From b8286bc7fe520e7117e7b6e1a1fd4c0df439aa3a Mon Sep 17 00:00:00 2001
From: Felix Fietkau <nbd@nbd.name>
Date: Thu, 2 Jul 2026 15:21:12 +0000
Subject: [PATCH] wifi: mt76: mt7915: unregister thermal cooling device on
 hwmon failure

mt7915_thermal_init() registered the thermal cooling device and its sysfs
link, then returned the hwmon registration error without undoing them.
The cooling device (not devm-managed) and the link then leaked, and its
callbacks referenced the freed phy. Unregister the cooling device before
returning the error.

Fixes: 0ae3ff568451 ("mt76: mt7915: fix hwmon temp sensor mem use-after-free")
Signed-off-by: Felix Fietkau <nbd@nbd.name>

Upstream-Status: Backport [b8286bc7fe520e7117e7b6e1a1fd4c0df439aa3a]
OpenWrt-Drop-When: package/kernel/mt76/Makefile PKG_SOURCE_VERSION contains
  b8286bc7fe520e7117e7b6e1a1fd4c0df439aa3a (or an mt76 equivalent of it).
License: BSD-3-Clause-Clear
---
 mt7915/init.c | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/mt7915/init.c b/mt7915/init.c
index f2ed094..2b20037 100644
--- a/mt7915/init.c
+++ b/mt7915/init.c
@@ -248,7 +248,12 @@ static int mt7915_thermal_init(struct mt7915_phy *phy)
 
 	hwmon = devm_hwmon_device_register_with_groups(&wiphy->dev, name, phy,
 						       mt7915_hwmon_groups);
-	return PTR_ERR_OR_ZERO(hwmon);
+	if (IS_ERR(hwmon)) {
+		mt7915_unregister_thermal(phy);
+		return PTR_ERR(hwmon);
+	}
+
+	return 0;
 }
 
 static void mt7915_led_set_config(struct led_classdev *led_cdev,
