From 2e6968e9286f3573016b9f804d4945373a21c489 Mon Sep 17 00:00:00 2001
From: Felix Fietkau <nbd@nbd.name>
Date: Thu, 8 Oct 2026 09:44:25 +0200
Subject: [PATCH] wifi: mt76: bypass DPD on a scan channel while a monitor is
 active

Commit "mt76: fix monitor rx FCS error in DFS channel" set
CH_SWITCH_NORMAL for every channel switch while a monitor interface is
active, to keep CH_SWITCH_DFS away from a monitored DFS channel. The
monitor check comes before the offchannel check, so a scan channel also
gets CH_SWITCH_NORMAL instead of CH_SWITCH_SCAN_BYPASS_DPD, and the
firmware runs the full calibration on each scan channel.

On an MT7981 with a monitor on the 5 GHz phy, a scan on that phy took
10.8 to 11.0 s instead of 2.9 to 3.1 s. hostapd aborts its first scan
after 10 s, so ACS never completes a scan there.

Apply the monitor rule only on the operating channel.

Fixes: 24e69f6bc3ca ("mt76: fix monitor rx FCS error in DFS channel")
Link: https://patch.msgid.link/20261008074425.2717811-1-nbd@nbd.name
Signed-off-by: Felix Fietkau <nbd@nbd.name>

Upstream-Status: Backport [2e6968e9286f3573016b9f804d4945373a21c489]
OpenWrt-Drop-When: package/kernel/mt76/Makefile PKG_SOURCE_VERSION contains
  2e6968e9286f3573016b9f804d4945373a21c489 (or an mt76 equivalent of it).
License: BSD-3-Clause-Clear
---
 mt7615/mcu.c | 3 ++-
 mt7915/mcu.c | 3 ++-
 mt7921/mcu.c | 3 ++-
 mt7996/mcu.c | 3 ++-
 4 files changed, 8 insertions(+), 4 deletions(-)

diff --git a/mt7615/mcu.c b/mt7615/mcu.c
index ff57ede..ac23164 100644
--- a/mt7615/mcu.c
+++ b/mt7615/mcu.c
@@ -2143,7 +2143,8 @@ int mt7615_mcu_set_chan_info(struct mt7615_phy *phy, int cmd)
 	};
 
 	if (cmd == MCU_EXT_CMD(SET_RX_PATH) ||
-	    phy->mt76->hw->conf.flags & IEEE80211_CONF_MONITOR)
+	    (phy->mt76->hw->conf.flags & IEEE80211_CONF_MONITOR &&
+	     !phy->mt76->offchannel))
 		req.switch_reason = CH_SWITCH_NORMAL;
 	else if (phy->mt76->offchannel)
 		req.switch_reason = CH_SWITCH_SCAN_BYPASS_DPD;
diff --git a/mt7915/mcu.c b/mt7915/mcu.c
index 6f2ac45..5f35455 100644
--- a/mt7915/mcu.c
+++ b/mt7915/mcu.c
@@ -2869,7 +2869,8 @@ int mt7915_mcu_set_chan_info(struct mt7915_phy *phy, int cmd)
 	if (mt76_connac_spe_idx(phy->mt76->antenna_mask))
 		req.tx_path_num = fls(phy->mt76->antenna_mask);
 
-	if (phy->mt76->hw->conf.flags & IEEE80211_CONF_MONITOR)
+	if (phy->mt76->hw->conf.flags & IEEE80211_CONF_MONITOR &&
+	    !phy->mt76->offchannel)
 		req.switch_reason = CH_SWITCH_NORMAL;
 	else if (phy->mt76->offchannel ||
 		 phy->mt76->hw->conf.flags & IEEE80211_CONF_IDLE)
diff --git a/mt7921/mcu.c b/mt7921/mcu.c
index 7abd1d9..f05c670 100644
--- a/mt7921/mcu.c
+++ b/mt7921/mcu.c
@@ -917,7 +917,8 @@ int mt7921_mcu_set_chan_info(struct mt792x_phy *phy, int cmd)
 		req.channel_band = chandef->chan->band;
 
 	if (cmd == MCU_EXT_CMD(SET_RX_PATH) ||
-	    dev->mt76.hw->conf.flags & IEEE80211_CONF_MONITOR)
+	    (dev->mt76.hw->conf.flags & IEEE80211_CONF_MONITOR &&
+	     !phy->mt76->offchannel))
 		req.switch_reason = CH_SWITCH_NORMAL;
 	else if (phy->mt76->offchannel)
 		req.switch_reason = CH_SWITCH_SCAN_BYPASS_DPD;
diff --git a/mt7996/mcu.c b/mt7996/mcu.c
index 1d2ecd9..8d0b34c 100644
--- a/mt7996/mcu.c
+++ b/mt7996/mcu.c
@@ -4346,7 +4346,8 @@ int mt7996_mcu_set_chan_info(struct mt7996_phy *phy, u16 tag)
 		.channel_band = ch_band[chandef->chan->band],
 	};
 
-	if (phy->mt76->hw->conf.flags & IEEE80211_CONF_MONITOR)
+	if (phy->mt76->hw->conf.flags & IEEE80211_CONF_MONITOR &&
+	    !phy->mt76->offchannel)
 		req.switch_reason = CH_SWITCH_NORMAL;
 	else if (phy->mt76->offchannel || !phy->mt76->chanctx)
 		req.switch_reason = CH_SWITCH_SCAN_BYPASS_DPD;
