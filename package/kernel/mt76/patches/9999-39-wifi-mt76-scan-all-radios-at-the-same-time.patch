-	memset(&dev->scan, 0, sizeof(dev->scan));
-	dev->scan.req = &req->req;
+	for_each_set_bit(i, &phy_mask, ARRAY_SIZE(dev->phys)) {
+		phy = dev->phys[i];
+		mlink = mt76_get_vif_phy_link(phy, vif);
+		if (IS_ERR(mlink)) {
+			ret = PTR_ERR(mlink);
