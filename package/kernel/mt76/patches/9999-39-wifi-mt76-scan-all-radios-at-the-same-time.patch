 	if (offchannel)
 		mt76_offchannel_notify(phy, true);
@@ -175,8 +224,8 @@ void mt76_scan_work(struct work_struct *work)
 
 	if (chandef.chan->flags & (IEEE80211_CHAN_NO_IR | IEEE80211_CHAN_RADAR)) {
