+static int mt76_scan_next_chan_idx(struct mt76_phy *phy)
+{
+	struct cfg80211_scan_request *req = &phy->dev->scan.req->req;
+	int i;
+
+	for (i = phy->scan.chan_idx; i < req->n_channels; i++)
+		if (mt76_scan_chan_phy(phy->hw, req->channels[i]) == phy)
+			return i;
+
+	return -1;
+}
