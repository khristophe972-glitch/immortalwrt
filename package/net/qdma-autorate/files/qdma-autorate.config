config qdma-autorate 'main'
	# 1 = run at boot (also needs: service qdma-autorate enable)
	option enabled '1'
	# logical WAN interface whose ifup restarts the service
	option wan 'wan'
	# LAN conduit and QDMA queues of the LAN ports (DSA p0-p3, p5 = queues 3,4,5,6,8)
	option lan_dev 'eth0'
	option queues '3,4,5,6,8'
	option watchdog_ms '2000'
	# controller flags (v4 defaults spelled out); add --csv /tmp/qdma-autorate.csv to debug
	option args '--start 300 --floor 150 --ceil 380 --cut-thresh 10 --inc-thresh 5 --dec 0.95 --cut-cooldown-ms 400 --bind-backlog-frac 0.8 --probe-step 10 --probe-interval-ms 500 --fast-step 20'
	# set by the init script: SQM download rate before the service set it to 0, and its sqm section
	option sqm_download_orig ''
	option sqm_section ''
