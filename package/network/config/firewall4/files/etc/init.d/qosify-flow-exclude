#!/bin/sh /etc/rc.common
# qosify-flow-exclude — keep qosify video flows out of the flowtable offload.
#
# Requires the fw4 ruleset patch 003-qosify-video-flow-exclusion (which defines
# the sets qosify_video_v4 / qosify_video_v6) and the qosify ubus service.

START=98
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/qosify-flow-exclude-run
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
