#!/bin/sh
# qosify-flow-exclude-run
#
# Keep qosify-classified video flows in the software path.
#
# The fw4 ruleset (patch 003-qosify-video-flow-exclusion) accepts traffic
# towards/from the qosify_video_v4 / qosify_video_v6 sets before the flowtable
# offload rule, so video flows never enter the flowtable and stay subject to
# qosify marking + CAKE.  qosify-dyn re-resolves streaming DNS over time, so the
# IP set rotates; this daemon mirrors the current video IPs from `ubus call
# qosify dump` into the two nftables sets, only touching nft when the set
# actually changed.

TBL="inet fw4"
SET_V4="qosify_video_v4"
SET_V6="qosify_video_v6"
INTERVAL="${QOSIFY_SYNC_INTERVAL:-60}"
STATEDIR="/tmp/qosify-flow-exclude"

mkdir -p "$STATEDIR"

# The sets are defined by the fw4 ruleset; wait until fw4 has loaded it.
while ! nft list set "$TBL" "$SET_V4" >/dev/null 2>&1; do
	sleep 5
done

resync() {
	local video v4 v6 ip changed=0

	video=$(ubus call qosify dump 2>/dev/null |
		jsonfilter -e '@.entries[@.dscp="video"].addr') || return 1
	[ -n "$video" ] || return 1

	v4=$(printf '%s\n' "$video" | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$')
	v6=$(printf '%s\n' "$video" | grep ':')

	printf '%s\n' "$v4" | cmp -s "$STATEDIR/v4" - || changed=1
	printf '%s\n' "$v6" | cmp -s "$STATEDIR/v6" - || changed=1

	# After `fw4 reload` the sets are recreated empty; repopulate them.
	if [ -s "$STATEDIR/v4" ] || [ -s "$STATEDIR/v6" ]; then
		if ! nft list set "$TBL" "$SET_V4" 2>/dev/null | grep -q 'elements = {'; then
			changed=1
		fi
	fi

	[ "$changed" -eq 1 ] || return 0

	{
		echo "flush set $TBL $SET_V4"
		for ip in $v4; do
			echo "add element $TBL $SET_V4 { $ip }"
		done
		echo "flush set $TBL $SET_V6"
		for ip in $v6; do
			echo "add element $TBL $SET_V6 { $ip }"
		done
	} | nft -f - 2>/dev/null || return 1

	printf '%s\n' "$v4" > "$STATEDIR/v4"
	printf '%s\n' "$v6" > "$STATEDIR/v6"

	logger -t qosify-flow-exclude \
		"video set synced: $(printf '%s\n' "$v4" | wc -l) v4, $(printf '%s\n' "$v6" | wc -l) v6"

	return 0
}

while true; do
	resync
	sleep "$INTERVAL"
done
