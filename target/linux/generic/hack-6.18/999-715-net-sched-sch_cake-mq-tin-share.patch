+/* Change uniquement le debit du shaper dur d'instance, sans toucher aux
+ * seuils de tin. Meme conversion que cake_set_rate().
+ */
+static void cake_mq_set_shaper_rate(struct cake_sched_data *q, u64 rate)
+{
+	u64 rate_ns = ((u64)NSEC_PER_SEC) << 34;
+	u16 rate_shft = 34;
+
+	rate_ns = div64_u64(rate_ns, max_t(u64, 64, rate));
+	while (!!(rate_ns >> 34)) {
+		rate_ns >>= 1;
+		rate_shft--;
+	}
+	q->rate_ns = rate_ns;
+	q->rate_shft = rate_shft;
+}
