From: khristophe972 <khristophe972@gmail.com>
Date: Thu, 23 Jul 2026 15:40:00 +0200
Subject: [PATCH] netfilter: nft_flow_offload: preserve DSCP through hardware offload

Store the original DSCP value in the flow_offload_tuple when a flow
is offloaded, so hardware/PPE offload paths can honor the original
DSCP marking instead of losing/overwriting it.

Based on work by Airoha (915-01 patch series).

---
 include/net/netfilter/nf_flow_table.h | 1 +
 net/netfilter/nft_flow_offload.c      | 24 ++++++++++++++++++++++++
 2 files changed, 25 insertions(+)

--- a/include/net/netfilter/nf_flow_table.h
+++ b/include/net/netfilter/nf_flow_table.h
@@ -138,6 +138,7 @@
 	u8				dir:2,
 					xmit_type:3,
 					encap_num:2,
 					in_vlan_ingress:2;
+	u8				dscp;
 	u16				mtu;
 	union {
 		struct {
--- a/net/netfilter/nft_flow_offload.c
+++ b/net/netfilter/nft_flow_offload.c
@@ -16,6 +16,8 @@
 #include <net/netfilter/nf_conntrack_core.h>
 #include <net/netfilter/nf_conntrack_extend.h>
 #include <net/netfilter/nf_flow_table.h>
+#include <net/dsfield.h>
+#include <net/inet_dscp.h>
 
 struct nft_flow_offload {
 	struct nft_flowtable	*flowtable;
@@ -401,6 +403,27 @@
 }
 EXPORT_SYMBOL_GPL(flow_offload_bridge_init);
 
+static void nft_flow_set_dscp(const struct nft_pktinfo *pkt,
+			      struct flow_offload *flow,
+			      enum ip_conntrack_dir dir)
+{
+	struct flow_offload_tuple *tuple = &flow->tuplehash[dir].tuple;
+	struct sk_buff *skb = pkt->skb;
+
+	switch (skb->protocol) {
+	case htons(ETH_P_IP):
+		tuple->dscp = FIELD_GET(INET_DSCP_MASK,
+					ipv4_get_dsfield(ip_hdr(skb)));
+		break;
+	case htons(ETH_P_IPV6):
+		tuple->dscp = FIELD_GET(INET_DSCP_MASK,
+					ipv6_get_dsfield(ipv6_hdr(skb)));
+		break;
+	default:
+		break;
+	}
+}
+
 static bool nft_flow_offload_skip(struct sk_buff *skb, int family)
 {
 	if (skb_sec_path(skb))
@@ -496,6 +519,9 @@
 	if (!flow)
 		goto err_flow_alloc;
 
+	nft_flow_set_dscp(pkt, flow, dir);
+	nft_flow_set_dscp(pkt, flow, !dir);
+
 	if (routing)
 		flow_offload_route_init(flow, &route);
 	else
