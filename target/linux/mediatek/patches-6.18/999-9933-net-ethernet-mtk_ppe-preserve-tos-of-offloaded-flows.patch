From: khristophe972 <khristophe972@gmail.com>
Date: Tue, 06 Oct 2026 00:00:00 +0200
Subject: [PATCH] net: ethernet: mtk_ppe: program the TOS of offloaded flows

The FoE ib2 entry carries an 8-bit TOS/DSCP field at [31:24]
(MTK_FOE_IB2_DSCP, shared by the v1 and v2 layouts), but nothing ever
writes it: mtk_foe_entry_prepare() only sets DEST_PORT_V2 and PORT_AG_V2,
so the PPE emits TOS 0 on offloaded flows (measured on MT7986/6.18.52:
ingress 0xb8 -> ib2 00f08501 -> egress 0x00).

Read the TOS octet that 999-dscp-02 now exposes in the flow rule
(FLOW_DISSECTOR_KEY_IP, family agnostic: IPv4 TOS and IPv6 Traffic Class)
and program it into the ib2 DSCP field so the hardware offload path keeps
the marking instead of zeroing it.  The Airoha driver does the same with
AIROHA_FOE_IB2_DSCP (915-02).

The trigger DSCP is the one 999-dscp-01 copies to both tuple directions,
and the ECN bits are forced to 0.  Bridge flows are left alone, as the
software bridge path already carries the marking.

Signed-off-by: khristophe972 <khristophe972@gmail.com>
Source: inspired by Airoha 915-02 (Lorenzo Bianconi, net-next)
License: GPL-2.0-only
---
 drivers/net/ethernet/mediatek/mtk_ppe.h         |  2 ++
 drivers/net/ethernet/mediatek/mtk_ppe.c         | 12 ++++++++++++
 drivers/net/ethernet/mediatek/mtk_ppe_offload.c | 11 ++++++++++-
 3 files changed, 24 insertions(+), 1 deletion(-)

--- a/drivers/net/ethernet/mediatek/mtk_ppe.h
+++ b/drivers/net/ethernet/mediatek/mtk_ppe.h
@@ -388,6 +388,8 @@
 			  u8 *dest_mac);
 int mtk_foe_entry_set_pse_port(struct mtk_eth *eth,
 			       struct mtk_foe_entry *entry, u8 port);
+int mtk_foe_entry_set_dscp(struct mtk_eth *eth,
+			   struct mtk_foe_entry *entry, u8 dscp);
 int mtk_foe_entry_set_ipv4_tuple(struct mtk_eth *eth,
 				 struct mtk_foe_entry *entry, bool orig,
 				 __be32 src_addr, __be16 src_port,
--- a/drivers/net/ethernet/mediatek/mtk_ppe.c
+++ b/drivers/net/ethernet/mediatek/mtk_ppe.c
@@ -455,6 +455,18 @@
 	return 0;
 }

+/* ib2[31:24] is the TOS octet the PPE emits on the offloaded flow. */
+int mtk_foe_entry_set_dscp(struct mtk_eth *eth,
+			   struct mtk_foe_entry *entry, u8 dscp)
+{
+	u32 *ib2 = mtk_foe_entry_ib2(eth, entry);
+
+	*ib2 &= ~MTK_FOE_IB2_DSCP;
+	*ib2 |= FIELD_PREP(MTK_FOE_IB2_DSCP, dscp);
+
+	return 0;
+}
+
 int mtk_foe_entry_set_ipv4_tuple(struct mtk_eth *eth,
 				 struct mtk_foe_entry *entry, bool egress,
 				 __be32 src_addr, __be16 src_port,
--- a/drivers/net/ethernet/mediatek/mtk_ppe_offload.c
+++ b/drivers/net/ethernet/mediatek/mtk_ppe_offload.c
@@ -313,7 +313,7 @@
 	int offload_type = 0;
 	int wed_index = -1;
 	u16 addr_type = 0;
-	u8 l4proto = 0;
+	u8 l4proto = 0, dsfield = 0;
 	int err = 0;
 	int i;

@@ -373,6 +373,13 @@
 		return -EOPNOTSUPP;
 	}

+	if (flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_IP)) {
+		struct flow_match_ip match;
+
+		flow_rule_match_ip(rule, &match);
+		dsfield = match.key->tos;
+	}
+
 	switch (addr_type) {
 	case 0:
 		offload_type = MTK_PPE_PKT_TYPE_BRIDGE;
@@ -453,6 +460,9 @@
 	if (err)
 		return err;

+	if (dsfield && offload_type != MTK_PPE_PKT_TYPE_BRIDGE)
+		mtk_foe_entry_set_dscp(eth, &foe, dsfield);
+
 	if (flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_PORTS)) {
 		struct flow_match_ports ports;

