From: khristophe972-glitch <khristophe972@gmail.com>
Subject: [PATCH] net: ethernet: mtk_eth_soc: implement ethtool get/set_channels

ethtool -l / -L on mtk_eth_soc fail with -EOPNOTSUPP because
mtk_ethtool_ops exposes neither .get_channels nor .set_channels; no
ethtool userspace version can work around a missing kernel op.

Report ring counts from the netdev queues allocated in mtk_add_mac()
(alloc_etherdev_mqs with eth->soc->num_tx_queues TX and eth->soc->rss_num
RX on MTK_RSS SoCs), and allow changing the number of active TX queues at
runtime via netif_set_real_num_tx_queues(). The TX path already honours
real_num_tx_queues (mtk_select_queue), and sch_mq-based cake_mq follows it
through .change_real_num_tx, so narrowing the active TX queues is safe and
effective. RX ring count is a hardware property (RSS/LRO): both the ioctl
and the netlink CHANNELS setter carry the current rx_count when only TX is
requested, so set_channels only rejects a request whose rx_count differs
from the live RX queue count, and otherwise ignores it.

Signed-off-by: khristophe972-glitch <khristophe972@gmail.com>
---
 drivers/net/ethernet/mediatek/mtk_eth_soc.c |   31 +++++++++++++++++++++++++++++++
 1 file changed, 31 insertions(+)

--- a/drivers/net/ethernet/mediatek/mtk_eth_soc.c
+++ b/drivers/net/ethernet/mediatek/mtk_eth_soc.c
@@ -4758,3 +4758,32 @@ static const struct ethtool_ops mtk_ethtool_ops = {
+static void mtk_get_channels(struct net_device *dev,
+			     struct ethtool_channels *channels)
+{
+	channels->max_tx = dev->num_tx_queues;
+	channels->max_rx = dev->num_rx_queues;
+	channels->tx_count = dev->real_num_tx_queues;
+	channels->rx_count = dev->real_num_rx_queues;
+}
+
+static int mtk_set_channels(struct net_device *dev,
+			    struct ethtool_channels *channels)
+{
+	/* RX is hardware-fixed (RSS/LRO).  Both the ioctl and netlink setters
+	 * carry the CURRENT rx_count when only TX is requested, so only a real
+	 * RX change (count differing from the live one) is rejected below.
+	 */
+	if (channels->combined_count ||
+	    channels->rx_count != dev->real_num_rx_queues)
+		return -EOPNOTSUPP;
+
+	if (!channels->tx_count || channels->tx_count > dev->num_tx_queues)
+		return -EINVAL;
+
+	if (channels->tx_count == dev->real_num_tx_queues)
+		return 0;
+
+	return netif_set_real_num_tx_queues(dev, channels->tx_count);
+}
+
 static const struct ethtool_ops mtk_ethtool_ops = {
 	.get_link_ksettings	= mtk_get_link_ksettings,
 	.set_link_ksettings	= mtk_set_link_ksettings,
@@ -4771,2 +4800,4 @@
 	.get_rxnfc		= mtk_get_rxnfc,
 	.set_rxnfc		= mtk_set_rxnfc,
+	.get_channels		= mtk_get_channels,
+	.set_channels		= mtk_set_channels,
