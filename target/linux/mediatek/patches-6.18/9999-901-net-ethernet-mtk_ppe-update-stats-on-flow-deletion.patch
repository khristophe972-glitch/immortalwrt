From: Pablo Neira Ayuso <pablo@netfilter.org>
Date: Thu, 29 Oct 2026 12:27:49 +1100
Subject: [PATCH nf-next,v4 2/2] net: ethernet: mtk_ppe: update stats on flow deletion

Update this driver to use the new approach to fetch stats on flow
deletion, introduced by ("netfilter: flowtable: retrieve stats on flow
deletion").

Acked-by: Lorenzo Bianconi <lorenzo@kernel.org>
Signed-off-by: Pablo Neira Ayuso <pablo@netfilter.org>

[ported to 6.18.56: the helper reads the counters through our MIB cache
(mtk_foe_entry_get_stats) instead of the raw MIB, and reports only the
difference since the last refresh.

This relies on an unwritten contract: mtk_foe_entry_get_stats() returns a
cumulative total (entry->prev_packets plus the accumulated MIB cache) and
never resets it. That function comes from 736-04; if that patch ever
changes the contract, this DESTROY path must be revisited.]

---
--- a/drivers/net/ethernet/mediatek/mtk_ppe_offload.c
+++ b/drivers/net/ethernet/mediatek/mtk_ppe_offload.c
@@ -587,6 +587,24 @@
 	return err;
 }
 
+static void
+mtk_flow_offload_update_stats(struct mtk_eth *eth, struct flow_cls_offload *f,
+			      struct mtk_flow_entry *entry)
+{
+	u64 packets, bytes;
+	int idle;
+
+	/* mtk_foe_entry_get_stats() refreshes the cached counters held by the
+	 * entry; the difference is what this call has to report, so a flow that
+	 * is polled and then deleted is never counted twice. */
+	packets = entry->packets;
+	bytes = entry->bytes;
+	mtk_foe_entry_get_stats(eth->ppe[entry->ppe_index], entry, &idle);
+	f->stats.pkts += entry->packets - packets;
+	f->stats.bytes += entry->bytes - bytes;
+	f->stats.lastused = jiffies - idle * HZ;
+}
+
 static int
 mtk_flow_offload_destroy(struct mtk_eth *eth, struct flow_cls_offload *f)
 {
@@ -597,6 +615,9 @@
 	if (!entry)
 		return -ENOENT;
 
+	/* Read the counters before the hardware entry goes away. */
+	mtk_flow_offload_update_stats(eth, f, entry);
+
 	mtk_foe_entry_clear(eth->ppe[entry->ppe_index], entry);
 	rhashtable_remove_fast(&eth->flow_table, &entry->node,
 			       mtk_flow_ht_params);
@@ -611,20 +632,13 @@
 mtk_flow_offload_stats(struct mtk_eth *eth, struct flow_cls_offload *f)
 {
 	struct mtk_flow_entry *entry;
-	u64 packets, bytes;
-	int idle;
 
 	entry = rhashtable_lookup_fast(&eth->flow_table, &f->cookie,
 				       mtk_flow_ht_params);
 	if (!entry)
 		return -ENOENT;
 
-	packets = entry->packets;
-	bytes = entry->bytes;
-	mtk_foe_entry_get_stats(eth->ppe[entry->ppe_index], entry, &idle);
-	f->stats.pkts += entry->packets - packets;
-	f->stats.bytes += entry->bytes - bytes;
-	f->stats.lastused = jiffies - idle * HZ;
+	mtk_flow_offload_update_stats(eth, f, entry);
 
 	return 0;
 }
