#!/bin/sh
# Réinstaller perl et ses modules après sysupgrade
# Retry x3 : le réseau n'est pas toujours prêt au premier boot (apk échoue silencieusement)
for i in 1 2 3; do
	if apk add perl perl-base; then
		logger -t 99-reinstall-perl "perl réinstallé (tentative $i)"
		exit 0
	fi
	logger -t 99-reinstall-perl "apk add perl échoué (tentative $i/3), nouvel essai dans 10s"
	sleep 10
done
exit 0
